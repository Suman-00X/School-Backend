# Copy to .env and fill in.

# Every school has its own PostgreSQL database and its own MongoDB database.
# You give ONE connection string per server; the database name in it is the platform
# registry (the list of schools). Each school's database is the same string with the
# name swapped for school_<code>, e.g. school_gvs.

# PostgreSQL: all relational data (people, academics, exams, marks...).
# Neon: use the pooled connection string (host contains "-pooler").
DATABASE_URL=postgres://postgres:postgres@localhost:5432/school_platform
PG_POOL_MAX=10

# MongoDB: audit log and other document data (no replica set needed).
# Atlas: the official mongodb+srv:// string; put the database name before the "?".
MONGO_URI=mongodb://localhost:27017/school_platform

# Creating a school runs CREATE DATABASE with this string (default: DATABASE_URL).
# Neon: the direct (non-pooled) string of a role that may create databases.
# POSTGRES_ADMIN_URL=

# Advanced: school database names and URLs ({database} is replaced by the name)
# TENANT_DATABASE_PREFIX=school_
# TENANT_DATABASE_URL_TEMPLATE=postgres://user:pass@host/{database}?sslmode=require
# TENANT_MONGO_URI_TEMPLATE=mongodb+srv://user:pass@cluster.mongodb.net/{database}?retryWrites=true
# Per API/worker process: schools whose pools stay open, and connections per school
# TENANT_MAX_OPEN=50
# TENANT_POOL_MAX=5

# Long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=

# Encrypts sensitive fields at rest (bank account, PAN). 32 bytes: `openssl rand -hex 32`.
# Required in production; back it up with your database backups, data is unreadable without it.
DATA_ENCRYPTION_KEY=

# Sign-in: access tokens (minutes), rotating refresh tokens (days), lockout, rate limit
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
AUTH_MAX_FAILED_LOGINS=5
AUTH_LOCKOUT_MINUTES=15
AUTH_RATE_LIMIT_MAX=10
# Web app address used in invitation and password-reset emails
WEB_APP_URL=http://localhost:5173

PORT=3000
NODE_ENV=development

# Comma-separated origins allowed by CORS (unset: any origin in dev, none in production)
ALLOWED_ORIGINS=

# Rate limiting per IP (defaults: 300 requests per 15 minutes)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Logging: trace | debug | info | warn | error | silent
LOG_LEVEL=info
# Release id on every log line (set by the deploy, e.g. the git SHA)
APP_VERSION=dev
# Requests / database queries slower than this (ms) are logged as warnings
SLOW_REQUEST_MS=1000
SLOW_QUERY_MS=500
# Public URL of this API (links in emails, download links)
APP_URL=http://localhost:3000
# Behind a load balancer: number of proxy hops to trust for client IPs
TRUST_PROXY_HOPS=0

# Redis (optional): durable jobs + shared cache. Required with >1 API instance.
# REDIS_URL=redis://localhost:6379

# File storage: local | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
# S3_BUCKET=
# S3_REGION=ap-south-1
# S3_ENDPOINT=            # for MinIO / R2 / Spaces
MAX_UPLOAD_BYTES=10485760

# Email: smtp | console | memory
EMAIL_DRIVER=console
# SMTP_URL=smtps://user:pass@smtp.example.com:465
EMAIL_FROM="School <no-reply@example.com>"

# SMS: http | console | memory
SMS_DRIVER=console
# SMS_HTTP_URL=
# SMS_API_KEY=
SMS_SENDER_ID=SCHOOL

# Online payments: razorpay | mock (default: razorpay in production, mock elsewhere).
# Each school enters its own Razorpay keys (ADMIN: PUT /api/v1/finance/payment-settings);
# they are stored encrypted with DATA_ENCRYPTION_KEY. mock never calls a real gateway.
# Dev/test only: PAYMENT_PROVIDER=mock (refused in production; default there is razorpay)
# PAYMENT_PROVIDER=mock

# SENTRY_DSN=
# Requires `npm install @sentry/node`; without it errors are only logged and counted

# Prometheus: GET /metrics with "Authorization: Bearer <token>". Unset: endpoint off
# METRICS_TOKEN=
